# Slack App の認証情報（HTTP Events モード）
# Bot User OAuth Token: OAuth & Permissions ページ (xoxb-...)
SLACK_BOT_TOKEN=xoxb-your-bot-token
#
# Signing Secret: Basic Information ページ
SLACK_SIGNING_SECRET=your-signing-secret

# 待受ポート（Sprite は 8080 を公開）
PORT=8080

# OpenAI
OPENAI_API_KEY=sk-your-api-key

# Rule Store の Vector Store ID
TRIBUNAL_RULE_VECTOR_STORE_ID=vs_your-vector-store-id

# 省略時は gpt-5
TRIBUNAL_MODEL=gpt-5
